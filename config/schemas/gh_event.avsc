{
  "type": "record",
  "name": "GhEvent",
  "namespace": "ghflow",
  "doc": "One GH Archive event from bronze, or an end-of-hour marker (ADR-0005). Generated; do not edit.",
  "fields": [
    {
      "name": "kind",
      "type": {
        "type": "enum",
        "name": "Kind",
        "symbols": [
          "EVENT",
          "END_OF_HOUR"
        ]
      }
    },
    {
      "name": "hour",
      "type": "string",
      "doc": "GH Archive hour key, e.g. 2026-08-03-0"
    },
    {
      "name": "partition",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "END_OF_HOUR: the partition it closes"
    },
    {
      "name": "rows_in_hour",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "END_OF_HOUR: the hour's bronze rows"
    },
