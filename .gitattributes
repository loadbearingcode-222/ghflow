# LF everywhere: containers and CI all run on Linux.
* text=auto eol=lf

# PowerShell stays CRLF: Windows PowerShell 5.1 mishandles LF in here-strings.
*.ps1 text eol=crlf

# Fixtures are byte-exact on purpose: hazard rows may carry odd bytes deliberately.
tests/fixtures/** -text

# Never touch these.
*.gz        binary
*.parquet   binary
*.png       binary
*.svg       text eol=lf
